# Copy to local.env (git-ignored) and fill in. Read by every script in tools/.
HADES_TEAM=ABCDE12345                    # Apple developer Team ID (paid account => 1-year profiles)
HADES_BUNDLE_ID=com.example.hades2       # any bundle ID you can register with that team
HADES_DEVICE=00000000-0000000000000000   # iPhone UDID: `xcrun devicectl list devices`
# HADES_SRC="$HOME/Library/Application Support/Steam/steamapps/common/Hades II/Hades II.app"
